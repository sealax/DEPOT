<div id="<%= dom_id cart %>" class="w-full sm:w-auto my-5 space-y-5">
  <h2 class="font-bold text-xl mb-4 pb-2 border-b-4 border-black">
    Your Pragmatic Cart
  </h2>

  <ul class="list-disc list-inside">
    <% cart.line_items.each do |item| %>
      <li><%= item.product.title %></li>
    <% end %>
  </ul>
</div>
